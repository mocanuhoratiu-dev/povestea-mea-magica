# Required for AI story generation. Use `vertex` to consume Google Cloud billing/credits.
NEXT_PUBLIC_SITE_MODE=production
# Set this to the final https:// domain once it is connected. It powers canonical,
# Open Graph, robots.txt and sitemap.xml URLs.
NEXT_PUBLIC_SITE_URL=https://www.povestea-mea-magica.ro
AI_PROVIDER=vertex
VERTEX_AI_PROJECT_ID=project-e0c2efff-d456-48f9-9fe
VERTEX_AI_LOCATION=global
VERTEX_AI_MODEL=gemini-3.5-flash
VERTEX_AI_FALLBACK_MODELS=gemini-3.1-flash-lite
# Lumi uses the primary creative model explicitly, independent of text fallback.
VERTEX_AI_LUMI_MODEL=gemini-3.5-flash
LUMI_AI_FALLBACK_MAX_MODELS=2
# Coperta este generată prin Vertex. Pollinations este doar fallback temporar,
# cu un prompt generic fără datele personale introduse pentru poveste.
VERTEX_AI_IMAGE_MODEL=gemini-3.1-flash-image
VERTEX_AI_IMAGE_FALLBACK_MODELS=
ALBUM_TEXT_TIMEOUT_MS=65000
ALBUM_IMAGE_TIMEOUT_MS=65000
ALBUM_IMAGE_MAX_ATTEMPTS=4
ALBUM_IMAGE_RETRY_DELAY_MS=8000
ALBUM_IMAGE_PACING_MS=750
ALBUM_PREVIEW_MAX_ATTEMPTS=3
ALBUM_PREVIEW_RETRY_DELAY_MS=1500
ALBUM_PREVIEW_RATE_LIMIT_MAX=4
ALBUM_AI_QC_ENABLED=true
ALBUM_QC_MODEL=gemini-3.1-flash-lite
ALBUM_QC_TIMEOUT_MS=24000
ALBUM_MAX_TEXT_CALLS=2
ALBUM_MAX_IMAGE_CALLS=40
ALBUM_MAX_QC_CALLS=40
ALBUM_MAX_ESTIMATED_COST_MICROS=2500000
ALBUM_TEXT_ESTIMATED_COST_MICROS=4000
ALBUM_IMAGE_ESTIMATED_COST_MICROS=45000
ALBUM_QC_ESTIMATED_COST_MICROS=1500
# Response budgets keep the public experience responsive when an AI model is busy.
AI_GENERATION_BUDGET_MS=55000
AI_MODEL_TIMEOUT_MS=35000
AI_FALLBACK_MAX_MODELS=2
VERTEX_AI_COVER_TIMEOUT_MS=35000
VERTEX_AI_IMAGE_MAX_MODELS=2
VERTEX_AI_LUMI_TIMEOUT_MS=18000
# Best-effort per-instance protection for the public launch. Add an edge rate
# limit before paid acquisition or traffic that can create multiple instances.
GENERATE_RATE_LIMIT_WINDOW_MS=3600000
GENERATE_RATE_LIMIT_MAX=5
# Aggregate telemetry is allow-listed, has no customer content and is stored in
# Cloud Run logs. This limit prevents the endpoint from being used as a log sink.
TELEMETRY_RATE_LIMIT_WINDOW_MS=86400000
TELEMETRY_RATE_LIMIT_MAX=120
# Optional local-only credential source. Cloud Run uses its runtime service account automatically.
# Base64-encoded service-account JSON should only be used when your Google Cloud policy allows it.
VERTEX_AI_SERVICE_ACCOUNT_JSON_BASE64=

# Optional fallback for Gemini Developer API / AI Studio.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite

# Google Cloud Text-to-Speech voices for Romanian narration. Cloud Run uses its
# runtime service account, so no API key is stored here.
GOOGLE_TTS_STORY_VOICE=ro-RO-Chirp3-HD-Zephyr
GOOGLE_TTS_LUMI_VOICE=ro-RO-Chirp3-HD-Aoede

# Optional transactional delivery. The key belongs in Cloud Run Secret Manager in
# production; this file is only for a local test environment.
RESEND_API_KEY=
EMAIL_FROM=office@povestea-mea-magica.ro
EMAIL_REPLY_TO=office@povestea-mea-magica.ro
EMAIL_DELIVERY_RATE_LIMIT_WINDOW_MS=3600000
EMAIL_DELIVERY_RATE_LIMIT_MAX=4

# Optional: required only for the detailed `/api/health` diagnostics response.
HEALTHCHECK_TOKEN=

# Stripe Checkout. Use test-mode Stripe secrets before launch, then replace them
# with live-mode secrets. Keep the public flag explicit for every environment.
NEXT_PUBLIC_STRIPE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# SmartBill invoicing. Test mode is intentionally locked to a Stripe test key
# and to a series containing TEST. Store SMARTBILL_TOKEN only in Secret Manager.
SMARTBILL_ENABLED=false
SMARTBILL_MODE=test
SMARTBILL_USERNAME=office@povestea-mea-magica.ro
SMARTBILL_TOKEN=
SMARTBILL_COMPANY_VAT_CODE=99999900
SMARTBILL_INVOICE_SERIES=PMMTEST
SMARTBILL_TAX_PERCENTAGE=0
SMARTBILL_TIMEOUT_MS=15000

# Paid-order fulfillment. Firestore stores encrypted-at-rest order data and a
# Cloud Storage bucket holds only generated covers. Both access secrets belong
# in Secret Manager for Cloud Run.
ORDER_STORE_PROJECT_ID=project-e0c2efff-d456-48f9-9fe
ORDER_STORAGE_BUCKET=
ORDER_TASKS_LOCATION=europe-west3
ORDER_TASKS_QUEUE=pmm-order-processing
ORDER_TASKS_SERVICE_ACCOUNT=
ORDER_ACCESS_SECRET=
ORDER_WORKER_SECRET=
